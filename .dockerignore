# Never send local secrets into a Docker build context.
.env
.env.*
!.env.example

# Local runtime and repository metadata.
.git/
.venv/
venv/
__pycache__/
*.py[cod]

# Keep the runtime screenshot fixture; other documentation is not part of the image.
.github/
action/
docs/*.md
docs/fixtures-img/*
!docs/fixtures-img/red-actions-permission-failure.png
scripts/
