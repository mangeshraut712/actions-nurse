# Copy the values you have received into an ignored .env.local file.
# Do not put production tokens, passwords, or organisation IDs in this file.

# Gemma is optional; Rules-only triage works without it.
GEMINI_API_KEY=

# Zetaris direct REST: the API base must end in /api/v1.0.
ZETARIS_REST_URL=https://your-zetaris-host/api/v1.0
ZETARIS_ORG_ID=your-numeric-org-id
ZETARIS_API_KEY=your-zetaris-api-key

# Local Zetaris evaluation only. The UI origin must stay on loopback; do not
# commit the local administrator values. When set, this session path takes
# precedence over direct REST and obtains a short-lived token per query.
ZETARIS_LOCAL_UI_URL=http://127.0.0.1:3000
ZETARIS_LOCAL_ADMIN_EMAIL=
ZETARIS_LOCAL_ADMIN_PASSWORD=

# The read-only CI evidence object and a truthful label for its dataset. The
# tracked local demo corpus is newly authored synthetic data, not CI history.
ZETARIS_CI_EVIDENCE_TABLE=ci_failure_signatures
ZETARIS_EVIDENCE_PROVENANCE=unclassified

# Optional Zetaris browser/OpenAPI values not consumed by either supported
# Actions Nurse provider above.
ZETARIS_BASE_URL=https://your-zetaris-web-ui
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# Set to 1 to exercise the recorded, credential-free demo path even when
# Zetaris credentials exist. Leave 0 to use a fully configured account.
ZETARIS_FIXTURE_MODE=0
